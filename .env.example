# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

PORT=3000

# --- Payment gateway (Razorpay) ---
# Leave these blank to run the app in DEMO payment mode
# (no real money is charged; a simulated order is created instead).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Tax rate applied on top of the plan subtotal (India GST = 18%).
GST_RATE=0.18
